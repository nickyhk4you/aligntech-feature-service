						"description": "Get detailed cache metrics including hit rate, misses, evictions"
					}
				},
				{
					"name": "Cache Summary",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Has cache details\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('caches');",
									"    pm.expect(response.caches).to.be.an('array');",
									"    pm.expect(response).to.have.property('overallHitRate');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/metrics/cache/summary",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "metrics", "cache", "summary"]
						},
						"description": "Get cache summary with hit rates for all caches"
					}
				}
			],
			"description": "Health check and monitoring endpoints"
		},
