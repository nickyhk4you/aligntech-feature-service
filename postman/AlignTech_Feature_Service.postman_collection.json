{
	"info": {
		"name": "AlignTech Feature Service",
		"description": "Feature flag management and evaluation service API collection.\n\n## Quick Start\n\n1. Set environment variables (see AlignTech_Environments.json)\n2. Run \"Create Flag\" to create a new flag\n3. Run \"Activate Flag\" to enable it\n4. Run \"Evaluate Flags\" to test evaluation\n\n## Authentication\n\nAdmin endpoints require `X-API-Key` header. Default dev key: `dev-secret-key`\n\n## Distributed Tracing\n\nAll responses include `X-Trace-Id` and `traceparent` headers for end-to-end debugging.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "12345678"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "flagId",
			"value": "",
			"type": "string",
			"description": "Auto-populated after creating a flag"
		},
		{
			"key": "apiKey",
			"value": "dev-secret-key",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health & Monitoring",
			"item": [
				{
					"name": "Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is OK\", function () {",
									"    pm.expect(pm.response.text()).to.equal(\"OK\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/health",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "health"]
						},
						"description": "Simple health check endpoint"
					}
				},
				{
					"name": "Actuator Health",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						},
						"description": "Spring Boot Actuator health endpoint with detailed status"
					}
				},
				{
					"name": "Prometheus Metrics",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/prometheus",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "prometheus"]
						},
						"description": "Prometheus-formatted metrics for monitoring"
					}
				},
				{
					"name": "Cache Metrics",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Has overall metrics\", function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('overall');",
									"    pm.expect(response.overall).to.have.property('overallHitRate');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/metrics/cache",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "metrics", "cache"]
